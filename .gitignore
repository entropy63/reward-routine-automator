# The repository carries only the extension source — everything else in the
# working tree stays local (development docs, tests, live-page captures,
# node_modules, build archives, browser profiles).

# --- development / tooling ---
node_modules/
test-results/
.playwright-mcp/
.playwright-report/
docs/
scripts/
tests/
tasks/
package.json
package-lock.json
playwright.config.js

# --- live Bing page captures (contain real account data) ---
*.html
!src-cupcake/*.html
*.htm

# --- archives and old snapshots ---
*.zip
*.7z
# The whole archive-history folder stays local (a stray copy without a .zip
# extension would otherwise slip past the rules above).
old zips/

# --- local scratch ---
models.md
tasks/
.claude/

# --- the ESM builds (donut / eclair / froyo) are extension source too: their
# tests and ESM markers ship with them (the "tests/"/"package.json" rules above
# match at any depth, so re-include the whole tree) ---
!src-donut/**
!src-eclair/**
!src-froyo/**

# --- src-gingerbread is a Vite/TypeScript build. Commit its SOURCE (the
# broad tests/ package.json *.html rules above would otherwise swallow it),
# but NOT the two generated trees: node_modules (deps) and dist (the build
# output). The built, loadable extension is distributed via GitHub Releases
# (the "Reward Routine Automator — Gingerbread V<version>.zip" asset), so it
# never needs to live in the repo — anyone can reproduce it with
# `npm --prefix src-gingerbread ci && run build`. ---
!src-gingerbread/**
src-gingerbread/node_modules/
src-gingerbread/dist/

# --- deepseek-harness is a separate, unrelated project that happens to sit
# in this working tree; it must never be committed here ---
deepseek-harness/
