# Copy to .env and edit. .env is ignored by git.

# Timezone the daily time is in (IANA name).
TZ=Asia/Riyadh

# Daily run time, 24-hour HH:MM in TZ.
RUN_TIME=09:30

# Optional: start up to this many minutes after RUN_TIME (0 = exactly on time).
RUN_JITTER_MIN=0

# Give up on a run after this many minutes.
RUN_TIMEOUT_MIN=90

# Attempts per day, and the wait before retry N after a failure (times N).
MAX_ATTEMPTS=3
RETRY_DELAY_MIN=15

# A run that ends incomplete (usually search points credited late) is tried
# once more after this many minutes; 0 never retries it.
INCOMPLETE_RETRY_MIN=120

# Run soon after start-up if today's time already passed and today has not run.
CATCH_UP=true

# Password for the web UI (user name: anything). Required if you publish the
# port beyond localhost.
WEB_PASSWORD=change-me

# Optional: notify on failures (and on success with NOTIFY_ON_SUCCESS=true).
# An ntfy topic URL (https://ntfy.sh/your-secret-topic) gets a plain-text push;
# any other URL gets a JSON POST {title, message, priority}.
NOTIFY_URL=
NOTIFY_ON_SUCCESS=false
