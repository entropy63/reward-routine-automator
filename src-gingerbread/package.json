{
  "name": "reward-routine-automator-gingerbread",
  "private": true,
  "version": "6.10.0",
  "description": "The fifth build — React + TypeScript rebuild of the Bing Rewards routine automator, with a from-scratch engine. Built with Vite + CRXJS; load src-gingerbread/dist unpacked.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:smoke": "node tests/brave-smoke.cjs",
    "test:ui": "node tests/ui-smoke.cjs",
    "test:controls": "node tests/brave-controls.cjs",
    "verify:browser": "npm run test:smoke && npm run test:ui && npm run test:controls"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-grid-layout": "^2.2.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
